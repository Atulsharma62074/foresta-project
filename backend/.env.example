# ── Server ──────────────────────────────
PORT=5000
NODE_ENV=development

# ── MongoDB ──────────────────────────────
MONGODB_URI=mongodb://localhost:27017/foresta_db
# Production: mongodb+srv://<user>:<pass>@cluster.mongodb.net/foresta_db

# ── Redis ────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── JWT ──────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_min_32_chars
JWT_REFRESH_SECRET=your_refresh_secret_min_32_chars
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# ── Email (Nodemailer) ────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=info@forestapaper.com
SMTP_PASS=your_app_password
EMAIL_FROM="Foresta Paper Industries <info@forestapaper.com>"
ADMIN_EMAIL=admin@forestapaper.com

# ── Frontend URL ─────────────────────────
FRONTEND_URL=http://localhost:3000

# ── Rate Limiting ─────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
